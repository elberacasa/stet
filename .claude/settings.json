{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node /Users/alejandroberacasa/stet/bin/stet.js hook pre-tool-use",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node /Users/alejandroberacasa/stet/bin/stet.js hook session-start",
            "timeout": 10
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node /Users/alejandroberacasa/stet/bin/stet.js hook post-compact",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
